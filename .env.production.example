# Copy to .env.production on the deployment host. Never commit .env.production or secret files.
COMPOSE_PROJECT_NAME=lockin-production
# The bundled PostgreSQL container is opt-in. Keep this profile for a
# self-contained VPS; clear it and set POSTGRES_HOST/POSTGRES_PORT to run
# against a managed PostgreSQL provider instead.
COMPOSE_PROFILES=bundled-db
# Use the immutable commit SHA or release identifier deployed to this host.
LOCKIN_IMAGE_TAG=replace-with-immutable-release-id
LOCKIN_PUBLIC_HOST=lockin.ly
TLS_CERT_PATH=/secure/lockin/fullchain.pem
TLS_KEY_PATH=/secure/lockin/privatekey.pem
# Public legal values embedded in the static application at build time. They
# are not secrets and must be reviewed by your legal owner before deployment.
LOCKIN_SUPPORT_EMAIL=support@lockin.ly
LOCKIN_LEGAL_ENTITY=Replace with your legal entity name
LOCKIN_LEGAL_ADDRESS=Replace with your registered address
LOCKIN_LEGAL_JURISDICTION=Replace with the governing jurisdiction

POSTGRES_DB=lockin
# Defaults to the bundled db service. Point these at a managed provider to keep
# the database outside the VPS; nothing else in this file has to change.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_OWNER_USER=lockin_owner
POSTGRES_RUNTIME_ROLE=lockin_app
POSTGRES_OWNER_PASSWORD_FILE=/secure/lockin/postgres_owner_password
POSTGRES_RUNTIME_PASSWORD_FILE=/secure/lockin/postgres_runtime_password
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=disable
POSTGRES_TRUSTED_PRIVATE_NETWORK=true
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_LOCK_TIMEOUT_MS=3000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Used by scripts/production/backup-postgres.sh; set 0 to disable local pruning.
BACKUP_RETENTION_DAYS=30

DJANGO_SECRET_KEY_FILE=/secure/lockin/django_secret_key
DJANGO_CSRF_TRUSTED_ORIGINS=https://lockin.ly
# Must match the private application-network subnet in compose.production.yaml.
DJANGO_TRUSTED_PROXY_CIDRS=172.28.0.0/24
ACCOUNT_LOGIN_SOURCE_ATTEMPT_LIMIT=30
ACCOUNT_SENSITIVE_SOURCE_REQUEST_LIMIT=30
ACCOUNT_POLICY_VERSION=replace-with-approved-policy-version
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Lock-in <no-reply@lockin.ly>
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=lockin-production
EMAIL_HOST_PASSWORD_FILE=/secure/lockin/email_host_password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10

# Optional server-side OAuth. Configure either all values for a provider or
# leave that provider entirely blank. This Compose file forwards the direct
# secret values from the uncommitted deployment environment. Other process
# runners can use GOOGLE_OAUTH_CLIENT_SECRET_FILE and APPLE_OAUTH_PRIVATE_KEY_FILE.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://lockin.ly/api/v1/auth/oauth/google/callback
APPLE_OAUTH_SERVICES_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# Store PEM newlines as literal \n sequences when using a single environment value.
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=https://lockin.ly/api/v1/auth/oauth/apple/callback
OAUTH_FLOW_TTL_SECONDS=600
OAUTH_HTTP_TIMEOUT_SECONDS=10

DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
OBSERVABILITY_SLOW_REQUEST_MS=1000
OBSERVABILITY_STATSD_HOST=metrics.example.edu
OBSERVABILITY_STATSD_PORT=8125
OBSERVABILITY_METRIC_PREFIX=lockin
OBSERVABILITY_ERROR_WEBHOOK_URL=https://monitoring.example.edu/v1/errors
OBSERVABILITY_ERROR_WEBHOOK_TOKEN_FILE=/secure/lockin/observability_error_webhook_token
OBSERVABILITY_ERROR_TIMEOUT_SECONDS=3

# Private file storage. Any S3-compatible provider works; changing provider is
# a change to these values only. Cloudflare R2 uses region "auto" and virtual
# addressing; a self-hosted MinIO needs STORAGE_ADDRESSING_STYLE=path.
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=lockin-media
STORAGE_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=replace-with-the-access-key-id
STORAGE_SECRET_ACCESS_KEY_FILE=/secure/lockin/storage_secret_access_key
STORAGE_ADDRESSING_STYLE=virtual
# Set only for an in-cluster plaintext endpoint such as MinIO on the same host.
STORAGE_ALLOW_INSECURE_ENDPOINT=false
# Set to true only for a documented single-host deployment whose media volume is
# backed up alongside the database. Production refuses local media otherwise.
STORAGE_ALLOW_LOCAL_MEDIA=false
# Optional key prefix when one bucket serves several environments.
STORAGE_LOCATION_PREFIX=

CONTENT_MAX_PDF_BYTES=52428800
# 90 MiB leaves multipart overhead below Cloudflare Free's upload ceiling.
CONTENT_MAX_AUDIO_BYTES=94371840
FILE_SCAN_HOST=clamav
FILE_SCAN_PORT=3310
FILE_SCAN_CONNECT_TIMEOUT_SECONDS=5
FILE_SCAN_READ_TIMEOUT_SECONDS=120
FILE_SCAN_MAX_ATTEMPTS=3
FILE_SCAN_RETRY_BASE_SECONDS=30
FILE_SCAN_RETRY_MAX_SECONDS=900
FILE_SCAN_CLAIM_TIMEOUT_SECONDS=300
FILE_SCAN_WORKER_INTERVAL_SECONDS=10
FILE_SCAN_BATCH_SIZE=8
PAYMENT_PROVIDER=none
DEFAULT_TRIAL_PLAN_CODE=lockin_trial
PAYMENT_CODE_ENCRYPTION_KEY_FILE=/secure/lockin/payment_code_encryption_key
MANUAL_PAYMENT_RATE_WINDOW_SECONDS=3600
MANUAL_PAYMENT_RATE_LIMIT=5
# Optional Libyana payment forwarding. Leave both blank until the bot is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAYMENT_CHAT_ID=
TELEGRAM_HTTP_TIMEOUT_SECONDS=5
SUBSCRIPTION_SCHEDULER_INTERVAL_SECONDS=900
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
OPERATIONAL_CLEANUP_INTERVAL_SECONDS=3600
OPERATIONAL_DATA_RETENTION_DAYS=30
COMMERCE_RECONCILIATION_INTERVAL_SECONDS=21600
ANALYTICS_REBUILD_INTERVAL_SECONDS=86400
MOTIVATION_REBUILD_INTERVAL_SECONDS=86400
OPERATIONS_SCHEDULER_POLL_SECONDS=15
OPERATIONS_JOB_LEASE_SECONDS=7200

GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=60
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
