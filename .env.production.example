# Copy to .env.production on the deployment host. Never commit .env.production or secret files.
COMPOSE_PROJECT_NAME=lockin-production
LOCKIN_PUBLIC_HOST=lockin.example.edu
TLS_CERT_PATH=/secure/lockin/fullchain.pem
TLS_KEY_PATH=/secure/lockin/privatekey.pem

POSTGRES_DB=lockin
POSTGRES_OWNER_USER=lockin_owner
POSTGRES_RUNTIME_ROLE=lockin_app
POSTGRES_OWNER_PASSWORD_FILE=/secure/lockin/postgres_owner_password
POSTGRES_RUNTIME_PASSWORD_FILE=/secure/lockin/postgres_runtime_password
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=disable
POSTGRES_TRUSTED_PRIVATE_NETWORK=true
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_LOCK_TIMEOUT_MS=3000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=30000

DJANGO_SECRET_KEY_FILE=/secure/lockin/django_secret_key
DJANGO_CSRF_TRUSTED_ORIGINS=https://lockin.example.edu
ACCOUNT_POLICY_VERSION=replace-with-approved-policy-version
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Lock-in <no-reply@lockin.example.edu>
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=lockin-production
EMAIL_HOST_PASSWORD_FILE=/secure/lockin/email_host_password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10

DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
OBSERVABILITY_SLOW_REQUEST_MS=1000

CONTENT_MAX_PDF_BYTES=52428800
CONTENT_MAX_AUDIO_BYTES=104857600
PAYMENT_PROVIDER=none
DEFAULT_TRIAL_PLAN_CODE=lockin_trial

GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=60
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
