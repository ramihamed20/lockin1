# Single-container edge for a managed container host (Render, Fly.io, Railway).
# TLS is terminated by the platform in front of this listener, and Cloudflare
# sits in front of that, so this server block speaks plain HTTP on ${PORT} and
# trusts the platform's X-Forwarded-Proto.
#
# The VPS deployment uses frontend/nginx/default.conf instead, which terminates
# TLS itself. Both keep the SPA and the API on one origin so the __Host- session
# cookie and CSRF contract are unchanged by a migration.
server {
    listen ${PORT};
    server_name _;

    root /srv/lockin/app;
    index index.html;
    client_max_body_size ${LOCKIN_MAX_BODY_SIZE};

    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'self'; img-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; style-src-elem 'self'; worker-src 'self' blob:" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"alive"}';
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        # Large study material streams through the API so entitlement and scan
        # checks still apply; buffering it here would stall downloads.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Operators use the capability-gated React console. Django's built-in admin
    # is never exposed publicly.
    location ^~ /admin/ {
        return 404;
    }

    # There is deliberately no /media/ location. Private study material is only
    # readable through /api/v1/files/, which enforces entitlement and clean-scan
    # state; serving MEDIA_ROOT here would bypass both checks.

    location /static/ {
        alias /app/staticfiles/;
        access_log off;
        expires 1h;
    }

    location /assets/ {
        access_log off;
        expires max;
        try_files $uri =404;
    }

    location = /service-worker.js {
        expires epoch;
        add_header Service-Worker-Allowed "/" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        expires -1;
        try_files $uri =404;
    }

    location = /robots.txt {
        expires -1;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
