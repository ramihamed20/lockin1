# Leave this relative value when Vite proxies requests to the local Django server.
VITE_API_BASE_URL=/api/v1

# Used only by Vite's local development proxy. It is never used as a browser API
# origin, so Django session cookies stay same-origin from the browser's perspective.
VITE_DJANGO_PROXY_TARGET=http://127.0.0.1:8000

# Optional in local development. Production Docker builds require all of these
# public legal/support values so the legal pages never ship with placeholders.
VITE_SUPPORT_EMAIL=support@example.test
VITE_LEGAL_ENTITY=Lock-in development environment
VITE_LEGAL_ADDRESS=Development only
VITE_LEGAL_JURISDICTION=Development only
VITE_POLICY_VERSION=development-v1
