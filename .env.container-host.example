# Phase 1: the single image on a managed container host (Render, Fly.io,
# Railway) with managed PostgreSQL and S3-compatible object storage.
#
# These are the values to enter in the host's environment settings, not a file
# to commit. Every one of them also exists in the VPS deployment, so migrating
# to compose.production.yaml later is a change of infrastructure, not of
# configuration keys. See docs/DEPLOYMENT.md.

DJANGO_SETTINGS_MODULE=config.settings.production

# ---------------------------------------------------------------- application
# Replace with the public hostname the platform assigns, or your own domain.
LOCKIN_PUBLIC_HOST=app.example.ly
DJANGO_ALLOWED_HOSTS=app.example.ly
PUBLIC_APP_URL=https://app.example.ly
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.ly
# At least 50 characters, generated by the platform's secret generator.
DJANGO_SECRET_KEY=replace-with-a-generated-production-secret
ACCOUNT_POLICY_VERSION=replace-with-the-approved-policy-version

# The platform terminates TLS and sets X-Forwarded-Proto; nginx inside the
# container forwards it from the loopback address only.
DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_TRUSTED_PROXY_CIDRS=127.0.0.1/32
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------- database
# The managed provider's connection URL, used by every serving process.
# It must name the least-privilege runtime role, not the database owner.
DATABASE_URL=postgresql://lockin_app:replace-runtime-password@db.example.supabase.co:5432/postgres?sslmode=require
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60
POSTGRES_RUNTIME_ROLE=lockin_app
# The owning role, used only by the one-shot release step at container start.
# Create the runtime role first with deploy/postgres/create-runtime-role.sql.
POSTGRES_OWNER_USER=postgres
POSTGRES_OWNER_PASSWORD=replace-with-the-database-owner-password
# Set to false on every extra web instance and on all worker services, so only
# one process per deploy runs migrations.
LOCKIN_RUN_RELEASE=true

# ------------------------------------------------------------- object storage
# Cloudflare R2 shown here. Any S3-compatible provider works with the same keys.
STORAGE_BACKEND=s3
STORAGE_BUCKET_NAME=lockin-media
STORAGE_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=replace-with-the-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-the-secret-access-key
STORAGE_ADDRESSING_STYLE=virtual

# ----------------------------------------------------------- file ingestion
# Whether a managed file must carry clean scan evidence before it can be
# published or delivered. State the decision explicitly; production defaults to
# enforcing it when this is unset.
#
# true  -- run the malware scanner as a separate private service on the same
#          platform and point FILE_SCAN_HOST at it.
# false -- no scanner. Only creators and administrators can upload managed
#          files, so the upload surface itself is the control. Upload
#          permissions, entitlement checks and the proxied /api/v1/files/
#          delivery path are identical in both modes.
CONTENT_REQUIRE_CLEAN_SCAN=true
# Read only when CONTENT_REQUIRE_CLEAN_SCAN=true.
FILE_SCAN_HOST=clamav.internal
FILE_SCAN_PORT=3310
CONTENT_MAX_PDF_BYTES=52428800
CONTENT_MAX_AUDIO_BYTES=94371840
# Keep nginx's ceiling above the largest accepted upload plus multipart
# overhead, and below Cloudflare's plan limit.
LOCKIN_MAX_BODY_SIZE=92m

# ------------------------------------------------------------------- delivery
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Lock-in <no-reply@example.ly>
EMAIL_HOST=smtp.example.ly
EMAIL_PORT=587
EMAIL_HOST_USER=lockin-production
EMAIL_HOST_PASSWORD=replace-with-the-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# -------------------------------------------------------------- observability
OBSERVABILITY_STATSD_HOST=metrics.example.ly
OBSERVABILITY_STATSD_PORT=8125
OBSERVABILITY_METRIC_PREFIX=lockin
OBSERVABILITY_ERROR_WEBHOOK_URL=https://monitoring.example.ly/v1/errors
OBSERVABILITY_ERROR_WEBHOOK_TOKEN=replace-with-a-dedicated-webhook-token
OBSERVABILITY_SLOW_REQUEST_MS=1000

# ----------------------------------------------------------------- commerce
PAYMENT_PROVIDER=none
DEFAULT_TRIAL_PLAN_CODE=lockin_trial
PAYMENT_CODE_ENCRYPTION_KEY=replace-with-a-long-random-payment-code-key
MANUAL_PAYMENT_RATE_WINDOW_SECONDS=3600
MANUAL_PAYMENT_RATE_LIMIT=5
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAYMENT_CHAT_ID=

# ------------------------------------------------------------ background work
# The scheduler and file-scan worker run the same image as separate services
# with their own commands; see docs/DEPLOYMENT.md. Their intervals are read from
# the same environment, so set these on every service.
SUBSCRIPTION_SCHEDULER_INTERVAL_SECONDS=900
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=60
OPERATIONAL_CLEANUP_INTERVAL_SECONDS=3600
OPERATIONAL_DATA_RETENTION_DAYS=30
COMMERCE_RECONCILIATION_INTERVAL_SECONDS=21600
ANALYTICS_REBUILD_INTERVAL_SECONDS=86400
MOTIVATION_REBUILD_INTERVAL_SECONDS=86400
OPERATIONS_SCHEDULER_POLL_SECONDS=15
OPERATIONS_JOB_LEASE_SECONDS=7200
FILE_SCAN_WORKER_INTERVAL_SECONDS=10
FILE_SCAN_BATCH_SIZE=8

# -------------------------------------------------------------------- runtime
GUNICORN_WORKERS=2
# Streamed private-file downloads hold a thread for the whole client transfer,
# so threads are sized for concurrent readers rather than for CPU.
GUNICORN_THREADS=8
GUNICORN_PRELOAD_APP=true
GUNICORN_TIMEOUT_SECONDS=60
PORT=10000
