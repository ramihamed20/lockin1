# Local development only. Copy this file to .env and replace the example values.
COMPOSE_PROJECT_NAME=lockin

# The database is configured either by one URL or by the discrete values below.
# DATABASE_URL is the portable form used by managed providers and container
# hosts; any POSTGRES_* value set alongside it wins, which is how the release
# step migrates as the owning role against the same connection.
# DATABASE_URL=postgresql://lockin:password@db:5432/lockin?sslmode=disable
POSTGRES_DB=lockin
POSTGRES_USER=lockin
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0
# prefer, require, verify-ca or verify-full. Managed providers need require.
POSTGRES_SSLMODE=prefer

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-this-local-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO
PUBLIC_APP_URL=http://127.0.0.1:5173
ACCOUNT_POLICY_VERSION=phase3-development
DEFAULT_FROM_EMAIL=Lock-in <no-reply@localhost>
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ACCOUNT_EMAIL_VERIFICATION_TTL_SECONDS=86400
ACCOUNT_PASSWORD_RESET_TTL_SECONDS=3600
ACCOUNT_EMAIL_CHANGE_TTL_SECONDS=3600
ACCOUNT_SESSION_AGE_SECONDS=43200
ACCOUNT_REMEMBER_SESSION_AGE_SECONDS=2592000
ACCOUNT_LOGIN_WINDOW_SECONDS=900
ACCOUNT_LOGIN_ATTEMPT_LIMIT=5
ACCOUNT_SENSITIVE_WINDOW_SECONDS=900
ACCOUNT_SENSITIVE_REQUEST_LIMIT=5
# Optional social sign-in. Keep secrets out of VITE_ variables. Each secret may
# instead use the existing *_FILE convention (for example,
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/google_oauth_client_secret).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/google/callback
APPLE_OAUTH_SERVICES_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oauth/apple/callback
OAUTH_FLOW_TTL_SECONDS=600
OAUTH_HTTP_TIMEOUT_SECONDS=10
CONTENT_MAX_PDF_BYTES=52428800
CONTENT_MAX_AUDIO_BYTES=104857600

# Private file storage. "filesystem" keeps uploads under MEDIA_ROOT, which is
# fine locally; every deployed environment uses "s3" against an S3-compatible
# provider (Cloudflare R2, MinIO, AWS S3, Backblaze B2). Switching provider is a
# change to these values only.
STORAGE_BACKEND=filesystem
# STORAGE_BUCKET_NAME=lockin-media-local
# STORAGE_ENDPOINT_URL=http://minio:9000
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# MinIO and other self-hosted gateways need path addressing.
# STORAGE_ADDRESSING_STYLE=path
# Only for a private, in-cluster plaintext endpoint such as a local MinIO.
# STORAGE_ALLOW_INSECURE_ENDPOINT=false
# Optional key prefix when one bucket is shared by several environments.
# STORAGE_LOCATION_PREFIX=
# Optional CDN base for deliberately public objects. Private study material is
# always delivered through the API, never from this URL.
# STORAGE_PUBLIC_BASE_URL=

# VITE_ values are public and must never contain secrets.
VITE_API_BASE_URL=/api/v1
# Phase 8 commerce. The fake adapter is development/test only; production must use none
# until an explicitly approved production provider adapter is implemented.
DEFAULT_TRIAL_PLAN_CODE=lockin_trial
PAYMENT_PROVIDER=none
PAYMENT_FAKE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_WEBHOOK_MAX_BYTES=65536
PAYMENT_CODE_ENCRYPTION_KEY=replace-with-a-long-random-payment-code-key
MANUAL_PAYMENT_RATE_WINDOW_SECONDS=3600
MANUAL_PAYMENT_RATE_LIMIT=5
# Optional. Leave both blank to run without Telegram forwarding.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PAYMENT_CHAT_ID=
TELEGRAM_HTTP_TIMEOUT_SECONDS=5
SUBSCRIPTION_SCHEDULER_INTERVAL_SECONDS=900
OBSERVABILITY_SLOW_REQUEST_MS=1000
