# Local development only. Copy this file to .env and replace the example values.
COMPOSE_PROJECT_NAME=lockin

POSTGRES_DB=lockin
POSTGRES_USER=lockin
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-this-local-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO

# VITE_ values are public and must never contain secrets.
VITE_API_BASE_URL=/api/v1
